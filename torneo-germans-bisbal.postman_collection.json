              "mode": "raw",
              "raw": "{\n  \"name\": \"New Player\",\n  \"username\": \"newplayer\",\n  \"password\": \"Password1\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Refresh access token",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "refresh"
              ]
            },
            "description": "Public \u2014 relies on the refresh_token cookie set at login (enable 'Send cookies' in Postman). Returns a new { access_token } and rotates the cookie.",
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "logout"
              ]
            },
            "description": "Public \u2014 revokes the refresh token tied to the refresh_token cookie.",
            "auth": {
              "type": "noauth"
            }
          }
        }
      ],
      "description": "Login/registration are public. Refresh and logout rely on the httpOnly refresh_token cookie set by Login \u2014 make sure Postman is configured to store and send cookies for {{baseUrl}}."
