# Copy this file to .env and adjust the values before running
# `docker compose up --build`.

MYSQL_DATABASE=torneo_germans_bisbal_db
MYSQL_ROOT_PASSWORD=change-me

# Optional: enables the AI Tournament Assistant feature. Leave empty to
# run without it.
OPENAI_API_KEY=

# Comma-separated list of origins allowed to call the API directly
# (only needed if you expose the backend separately from the frontend).
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
