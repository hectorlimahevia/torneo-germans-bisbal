          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "description": "Public. Returns { access_token } and sets the refresh_token httpOnly cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"james\",\n  \"password\": \"1234\"\n}"
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
